# Demo mode is the default. Leave these unset to run with no keys.

# demo (packaged fictional places) or server (local sandbox API)
VITE_DATA_SOURCE=demo

# Empty uses same-origin /api, which Vite proxies to the local API.
VITE_API_BASE=

# straight-line or osrm. Straight-line never invents a travel time.
VITE_ROUTING_PROVIDER=straight-line

# Only used when VITE_ROUTING_PROVIDER=osrm.
# The app asks before sending coordinates to this server.
# Example public instance: https://router.project-osrm.org
VITE_OSRM_BASE_URL=

# GitHub project-page deploys need the repo path, for example /Restroom-911/
VITE_BASE=/

# Local admin API only. Never commit a real password.
# "change-me" is rejected on purpose.
ADMIN_PASSWORD=
ADMIN_PORT=43124

# Optional. Set only if the browser calls the API on another origin.
# CORS_ORIGIN=http://127.0.0.1:43123
